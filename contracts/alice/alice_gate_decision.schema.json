{
  "$id": "https://bestbuds.local/schemas/alice_gate_decision.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowed_actions": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "blocked_actions": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "decision": {
      "enum": [
        "allow",
        "block",
        "require_confirmation"
      ],
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "type": [
          "object",
          "string"
        ]
      },
      "type": "array"
    },
    "gate_id": {
      "minLength": 1,
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "type": "string"
    },
    "truth_class": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_RUN",
        "UNIT_TEST_PASS",
        "UI_SMOKE_PASS",
        "NATIVE_PLATFORM_PASS",
        "PHYSICAL_DEVICE_PASS",
        "SIMULATOR_PASS",
        "SOURCE_PRESENT",
        "RECEIPT_CONFIRMED",
        "PENDING",
        "NON_CLAIM"
      ],
      "type": "string"
    }
  },
  "required": [
    "gate_id",
    "decision",
    "truth_class",
    "reason",
    "allowed_actions",
    "blocked_actions",
    "evidence_refs"
  ],
  "title": "Alice Gate Decision",
  "type": "object"
}
