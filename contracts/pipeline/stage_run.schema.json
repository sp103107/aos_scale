{
  "$id": "https://bestbuds.local/contracts/pipeline/stage_run.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "completed_stages": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "failed_stage": {
      "type": [
        "string",
        "null"
      ]
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "plan_id": {
      "minLength": 1,
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "started_at": {
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "enum": [
        "RUNNING",
        "PASS",
        "PASS_WITH_WARNINGS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "version": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "plan_id",
    "version",
    "status",
    "started_at"
  ],
  "title": "Stage Run",
  "type": "object"
}
