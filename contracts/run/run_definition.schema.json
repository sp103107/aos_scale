{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://bestbuds.local/contracts/run/run_definition.schema.json",
  "type":"object","additionalProperties":false,
  "required":["run_id","operator_id","facility_id","station_id","cultivars","capture_mode","unit","container_id","tare_g","maximum_capacity_g"],
  "properties":{
    "run_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "operator_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "facility_id":{"type":"string"},"station_id":{"type":"string"},
    "cultivars":{"type":"array","minItems":1,"items":{"type":"object","required":["cultivar_id","name"],"properties":{"cultivar_id":{"type":"string"},"name":{"type":"string","minLength":1}},"additionalProperties":false}},
    "capture_mode":{"enum":["automatic","manual"]},"unit":{"const":"g"},"container_id":{"type":"string"},
    "tare_g":{"type":"number","minimum":0},"measurement_stage":{"type":"string"},"weight_purpose":{"type":"string"},
    "stability_profile_id":{"type":"string"},"maximum_capacity_g":{"type":"number","exclusiveMinimum":0},
    "session_id":{"type":["string","null"]},"created_at":{"type":"string"}
  }
}
