{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://bestbuds.local/contracts/device/device_identity.schema.json",
  "type":"object","additionalProperties":false,
  "required":["device_id","transport","protocol","baud_rate","unit"],
  "properties":{"device_id":{"type":"string","minLength":1},"transport":{"enum":["usb_serial","serial_simulator","uno_q_internal_bridge"]},"protocol":{"const":"bbws-hx711-serial-v1"},"baud_rate":{"type":"integer","enum":[115200,9600]},"unit":{"const":"g"},"firmware_version":{"type":["string","null"]}}
}
