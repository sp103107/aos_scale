{
  "$id": "https://bestbuds.local/schemas/commit_receipt.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authoritative_paths": {
      "items": {
        "type": "string"
      },
      "minItems": 3,
      "type": "array"
    },
    "checkpoint_version": {
      "minimum": 1,
      "type": "integer"
    },
    "committed_at": {
      "minLength": 1,
      "type": "string"
    },
    "derivative_status": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "individual_record_path": {
      "minLength": 1,
      "type": "string"
    },
    "jsonl_event_id": {
      "minLength": 1,
      "type": "string"
    },
    "local_commit": {
      "const": true
    },
    "net_g": {
      "type": [
        "number",
        "null"
      ]
    },
    "receipt_id": {
      "minLength": 1,
      "type": "string"
    },
    "record_hash": {
      "minLength": 64,
      "type": "string"
    },
    "record_id": {
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "const": "committed"
    }
  },
  "required": [
    "receipt_id",
    "record_id",
    "committed_at",
    "authoritative_paths",
    "record_hash",
    "jsonl_event_id",
    "individual_record_path",
    "checkpoint_version",
    "local_commit",
    "status"
  ],
  "title": "Commit Receipt",
  "type": "object"
}
